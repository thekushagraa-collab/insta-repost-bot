{
  "name": "insta-repost-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Reposts videos from an old Instagram account to a new one, twice a day, using the official Instagram API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bot": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
